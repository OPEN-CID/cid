# Rust / Cargo
/target/
**/target/
Cargo.lock
# Keep Cargo.lock for binary crates, but workspace root includes it (Tauri convention keeps it)
# We'll explicitly include root Cargo.lock later via git add -f if needed, but ignore for now
# Uncomment if you want to keep lock:
# !Cargo.lock

# Node / frontend
/node_modules/
/dist/
/build/
.pnpm-store/
.yarn/

# Vite
/.vite/

# Tauri
/src-tauri/target/

# Env / secrets
.env
.env.*
*.env
*.key

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml

