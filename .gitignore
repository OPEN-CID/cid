# Rust / Cargo
/target/
**/target/
# Cargo.lock is committed, not ignored: this workspace ships binaries
# (cid-core, cid-tui, the Tauri shell), and the Dockerfile's
# `COPY Cargo.toml Cargo.lock ./` builds from a fresh clone — ignoring it made
# that COPY fail and let every build resolve its own dependency versions.

# Node / frontend
/node_modules/
/dist/
/build/
.pnpm-store/
.yarn/

# Vite
/.vite/

# Tauri
/src-tauri/target/

# Env / secrets
.env
.env.*
*.env
*.key

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml

# SQLite DBs (local dev)
*.db
*.db-journal
*.sqlite
*.sqlite3
cid-*.db

# Worktrees (managed)
.cid/
cid-worktrees/

# Disposable database for the Playwright suite (see playwright.config.ts) —
# kept out of the OS data dir so E2E runs never touch a real install.
.cid-e2e/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Playwright
/test-results/
/playwright-report/
/playwright/.cache/
blob-report/
# health-check.spec.ts's file.write/file.read round-trip test writes here —
# a real test artifact, regenerated every run, never meant to be committed.
# The path must match the spec's own `${__dirname}/_e2e_test_temp.txt`; an
# earlier /tests/ rule missed the e2e/ segment and so never matched anything.
/tests/e2e/_e2e_test_temp.txt

# Coverage
/coverage/

# Temp
tmp/
temp/
