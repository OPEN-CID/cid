# Playwright
/test-results/
/playwright-report/
/playwright/.cache/
blob-report/
# health-check.spec.ts's file.write/file.read round-trip test writes here —
# a real test artifact, regenerated every run, never meant to be committed.
# The path must match the spec's own `${__dirname}/_e2e_test_temp.txt`; an
# earlier /tests/ rule missed the e2e/ segment and so never matched anything.
/tests/e2e/_e2e_test_temp.txt

# Coverage
/coverage/

# Temp
tmp/
temp/
