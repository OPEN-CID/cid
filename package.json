{
  "name": "cid",
  "version": "0.1.0",
  "description": "CID - Collaborative Intelligent Development - Chat-native multi-agent coding platform",
  "type": "module",
  "scripts": {
    "predev": "npm run theme:generate",
    "dev": "vite",
    "dev:core": "cargo run -p cid-core -- --port 5919",
    "dev:all": "concurrently \"cargo run -p cid-core -- --port 5919\" \"vite\"",
    "prebuild": "npm run theme:generate",
    "build": "tsc && vite build",
    "theme:generate": "node scripts/generate-theme-css.mjs",
    "theme:check": "node scripts/generate-theme-css.mjs --check",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^15.0.7",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^24.1.0",
    "playwright": "^1.44.0",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "vitest-axe": "^0.1.0",
    "ws": "^8.21.1"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "dompurify": "^3.4.12",
    "esbuild": "^0.25.0"
  },
  "packageManager": "npm@11.0.0"
}
